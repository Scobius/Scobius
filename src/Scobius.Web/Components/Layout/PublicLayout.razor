@inherits LayoutComponentBase

<div class="min-h-screen flex flex-col bg-gray-50">
    <header class="bg-white border-b border-gray-200 py-4">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center">
            <a href="/" class="text-xl font-bold text-blue-600 tracking-tight">Scobius</a>
            <span class="ml-3 px-2 py-0.5 bg-gray-100 text-gray-500 text-xs font-medium rounded-full hidden sm:inline">Real-time chat</span>
        </div>
    </header>

    <main class="flex-1 flex items-center justify-center p-6">
        <div class="w-full max-w-md">
            @Body
        </div>
    </main>

    <footer class="py-6 text-center text-gray-400 text-sm">
        &copy; @DateTime.UtcNow.Year Scobius
    </footer>
</div>
