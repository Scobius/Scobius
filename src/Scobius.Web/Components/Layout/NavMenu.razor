@* Clean vertical nav for the authenticated sidebar. No dark gradient or old toggler. *@
@inject IWebAuthService AuthService
@inject ScobiusAuthStateProvider AuthProvider
@inject NavigationManager Navigation

<nav class="nav flex-column small">
    <AuthorizeView>
        <Authorized>
            <NavLink class="nav-link d-flex align-items-center gap-2 py-2 px-2 rounded" href="/" Match="NavLinkMatch.All">
                <span>🏠</span> Home
            </NavLink>
            <NavLink class="nav-link d-flex align-items-center gap-2 py-2 px-2 rounded" href="/profile">
                <span>👤</span> Profile
            </NavLink>
            <NavLink class="nav-link d-flex align-items-center gap-2 py-2 px-2 rounded" href="/friends">
                <span>👥</span> Friends
            </NavLink>

            <div class="mt-2 pt-2 border-top">
                <button class="btn btn-link nav-link text-start w-100 p-0 py-2 px-2 text-danger" @onclick="Logout">
                    Logout
                </button>
            </div>
        </Authorized>

        <NotAuthorized>
            <NavLink class="nav-link d-flex align-items-center gap-2 py-2 px-2 rounded" href="/login">
                Login
            </NavLink>
            <NavLink class="nav-link d-flex align-items-center gap-2 py-2 px-2 rounded" href="/register">
                Register
            </NavLink>
        </NotAuthorized>
    </AuthorizeView>
</nav>

@code {
    private async Task Logout()
    {
        try { await AuthService.LogoutAsync(); } catch { }
        Navigation.NavigateTo("/login", forceLoad: true);
    }
}

