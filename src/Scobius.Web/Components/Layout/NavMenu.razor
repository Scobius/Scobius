@* Clean vertical nav for the authenticated sidebar. *@
@inject IWebAuthService AuthService
@inject ScobiusAuthStateProvider AuthProvider
@inject NavigationManager Navigation

<nav class="flex flex-col space-y-1">
    <AuthorizeView>
        <Authorized>
            <NavLink class="nav-item nav-item-inactive [&.active]:nav-item-active" href="/" Match="NavLinkMatch.All">
                <span class="w-5 text-center">🏠</span> Home
            </NavLink>
            <NavLink class="nav-item nav-item-inactive [&.active]:nav-item-active" href="/profile">
                <span class="w-5 text-center">👤</span> Profile
            </NavLink>
            <NavLink class="nav-item nav-item-inactive [&.active]:nav-item-active" href="/friends">
                <span class="w-5 text-center">👥</span> Friends
            </NavLink>

            <div class="mt-4 pt-4 border-t border-gray-100">
                <button class="nav-item w-full text-red-600 hover:bg-red-50 transition-colors" @onclick="Logout">
                    <span class="w-5 text-center">🚪</span> Logout
                </button>
            </div>
        </Authorized>

        <NotAuthorized>
            <NavLink class="nav-item nav-item-inactive" href="/login">
                Login
            </NavLink>
            <NavLink class="nav-item nav-item-inactive" href="/register">
                Register
            </NavLink>
        </NotAuthorized>
    </AuthorizeView>
</nav>

@code {
    private async Task Logout()
    {
        try { await AuthService.LogoutAsync(); } catch { }
        Navigation.NavigateTo("/login", forceLoad: true);
    }
}
