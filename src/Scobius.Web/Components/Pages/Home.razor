@page "/"
@rendermode InteractiveServer
@attribute [Authorize]

<PageTitle>Scobius</PageTitle>

<div class="space-y-8">
    <div class="border-b border-gray-200 pb-5">
        <h2 class="text-3xl font-bold text-gray-900 tracking-tight">Welcome back 👋</h2>
        <p class="mt-2 text-sm text-gray-500">Select a conversation or find a friend to start chatting.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <div class="card-hover p-6">
            <div class="flex items-center gap-4 mb-4">
                <div class="w-10 h-10 bg-blue-100 rounded-lg flex items-center justify-center text-blue-600">
                    <span>👥</span>
                </div>
                <div>
                    <h3 class="text-sm font-semibold text-gray-900">Friends</h3>
                    <p class="text-xs text-gray-500">Manage your connections</p>
                </div>
            </div>
            <a href="/friends" class="btn-secondary w-full">
                View Friends
            </a>
        </div>

        <div class="card-hover p-6">
            <div class="flex items-center gap-4 mb-4">
                <div class="w-10 h-10 bg-purple-100 rounded-lg flex items-center justify-center text-purple-600">
                    <span>👤</span>
                </div>
                <div>
                    <h3 class="text-sm font-semibold text-gray-900">Profile</h3>
                    <p class="text-xs text-gray-500">Update your information</p>
                </div>
            </div>
            <a href="/profile" class="btn-secondary w-full hover:bg-purple-600 hover:text-white">
                Edit Profile
            </a>
        </div>
    </div>
</div>
