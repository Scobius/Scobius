@page "/register"
@layout PublicLayout
@inject IWebAuthService AuthService
@inject NavigationManager Navigation
@attribute [AllowAnonymous]

<PageTitle>Register — Scobius</PageTitle>

<div class="max-w-md w-full mx-auto">
  <div class="bg-white shadow-xl rounded-2xl border border-gray-100 overflow-hidden">
    <div class="p-8">
      <div class="text-center mb-8">
        <h1 class="text-2xl font-extrabold text-gray-900 tracking-tight">Create account</h1>
        <p class="text-sm text-gray-500 mt-2">Join Scobius today</p>
      </div>

      @if (!string.IsNullOrEmpty(successMessage))
      {
        <div class="mb-8 p-6 bg-green-50 rounded-xl border border-green-100 text-center">
          <div class="w-12 h-12 bg-green-100 rounded-full flex items-center justify-center text-green-600 mx-auto mb-4">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
          </div>
          <h3 class="text-lg font-bold text-green-900 mb-2">Success!</h3>
          <p class="text-sm text-green-700 mb-6">@successMessage</p>
          <a href="/login" class="btn-primary bg-green-600 hover:bg-green-700 shadow-green-500/20">
            Go to login
          </a>
        </div>
      }

      @if (!string.IsNullOrEmpty(errorMessage))
      {
        <div class="mb-6 p-4 bg-red-50 border-l-4 border-red-500 text-red-700 text-sm">
          <p class="font-medium">Registration failed</p>
          <p>@errorMessage</p>
        </div>
      }

      @if (string.IsNullOrEmpty(successMessage))
      {
        <EditForm FormName="registerForm" Model="model" OnValidSubmit="HandleRegister" class="space-y-4">
          <DataAnnotationsValidator />

          <div class="grid grid-cols-1 gap-4">
            <div>
              <label class="label">Username</label>
              <InputText class="input" @bind-Value="model.Username" placeholder="john_doe" />
              <div class="mt-1 text-xs text-red-600">
                <ValidationMessage For="() => model.Username" />
              </div>
            </div>

            <div>
              <label class="label">Display Name</label>
              <InputText class="input" @bind-Value="model.DisplayName" placeholder="John Doe" />
              <div class="mt-1 text-xs text-red-600">
                <ValidationMessage For="() => model.DisplayName" />
              </div>
            </div>

            <div>
              <label class="label">Email</label>
              <InputText type="email" class="input" @bind-Value="model.Email" placeholder="you@example.com" />
              <div class="mt-1 text-xs text-red-600">
                <ValidationMessage For="() => model.Email" />
              </div>
            </div>

            <div>
              <label class="label">Password</label>
              <InputText type="password" class="input" @bind-Value="model.Password" placeholder="••••••••" />
              <div class="mt-1 text-xs text-red-600">
                <ValidationMessage For="() => model.Password" />
              </div>
            </div>
          </div>

          <button type="submit" class="btn-primary w-full mt-4" disabled="@isLoading">
            @if (isLoading)
            {
              <svg class="animate-spin -ml-1 mr-3 h-5 w-5 text-white" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
              </svg>
            }
            Create Account
          </button>
        </EditForm>

        <div class="mt-8 pt-6 border-t border-gray-100 text-center">
          <p class="text-sm text-gray-500">
            Already have an account? <a href="/login" class="font-semibold text-blue-600 hover:text-blue-700">Sign in</a>
          </p>
        </div>
      }
    </div>
  </div>
</div>

@code {
  [SupplyParameterFromForm]
  private RegisterModel? model { get; set; }
  private string? successMessage;
  private string? errorMessage;
  private bool isLoading;

  protected override void OnInitialized() => model ??= new();

  private async Task HandleRegister()
  {
    isLoading = true;
    errorMessage = null;

    try
    {
      await AuthService.RegisterAsync(
          model.Username,
          model.DisplayName,
          model.Email,
          model.Password);

      successMessage = "Account created! Check your email to verify your account before logging in.";
    }
    catch (Exception ex)
    {
      errorMessage = ex.Message;
    }
    finally
    {
      isLoading = false;
    }
  }

  private class RegisterModel
  {
    [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Username is required")]
    public string Username { get; set; } = string.Empty;

    [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Display name is required")]
    public string DisplayName { get; set; } = string.Empty;

    [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Email is required")]
    [System.ComponentModel.DataAnnotations.EmailAddress(ErrorMessage = "Invalid email address")]
    public string Email { get; set; } = string.Empty;

    [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Password is required")]
    [System.ComponentModel.DataAnnotations.MinLength(8, ErrorMessage = "Password must be at least 8 characters")]
    public string Password { get; set; } = string.Empty;
  }
}
