@page "/friends"
@attribute [Authorize]

<PageTitle>Friends — Scobius</PageTitle>

<div class="space-y-6">
    <div class="border-b border-gray-200 pb-5">
        <h2 class="text-3xl font-bold text-gray-900 tracking-tight">Friends</h2>
        <p class="mt-2 text-sm text-gray-500">Manage your connections and find new people to chat with.</p>
    </div>

    <div class="card p-8 text-center">
        <div class="w-16 h-16 bg-blue-50 rounded-full flex items-center justify-center text-blue-600 mx-auto mb-4 text-2xl">
            <span>✨</span>
        </div>
        <h3 class="text-lg font-bold text-gray-900 mb-2">Coming Soon</h3>
        <p class="text-gray-500 max-w-sm mx-auto mb-8 text-sm">
            We're working on the social features! Soon you'll be able to manage your friends list, send requests, and start real-time chats from here.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
            <a href="/" class="btn-primary">
                Back to Home
            </a>
            <a href="/profile" class="btn-secondary">
                Go to Profile
            </a>
        </div>
    </div>
</div>
