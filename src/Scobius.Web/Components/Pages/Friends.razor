@page "/friends"
@attribute [Authorize]

<PageTitle>Friends — Scobius</PageTitle>

<div class="container py-4">
    <h3 class="mb-3">Friends</h3>

    <div class="card shadow-sm">
        <div class="card-body">
            <p class="text-muted">Friends &amp; connections are coming soon.</p>
            <p>
                You'll be able to see your friends list, send and accept requests, and start chats from here.
            </p>
            <a href="/" class="btn btn-outline-primary btn-sm">Back to Home</a>
            <a href="/profile" class="btn btn-link btn-sm">Go to Profile</a>
        </div>
    </div>
</div>
