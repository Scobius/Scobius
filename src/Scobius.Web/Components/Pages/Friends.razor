@page "/friends"
@rendermode InteractiveServer
@inject IWebUserService UserService
@attribute [Authorize]

<PageTitle>Friends — Scobius</PageTitle>

<div class="space-y-6">
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-gray-200 pb-5">
    <div>
      <h2 class="text-3xl font-bold text-gray-900 tracking-tight">Friends</h2>
      <p class="mt-2 text-sm text-gray-500">Manage your connections and start new conversations.</p>
    </div>
    <div class="flex items-center gap-3">
      <button class="btn-secondary">
        <span>📩</span>
        <span class="ml-2">Requests</span>
      </button>
      <button class="btn-primary">
        <span>➕</span>
        <span class="ml-2">Add Friend</span>
      </button>
    </div>
  </div>

  @if (isLoading)
  {
    <div class="flex justify-center py-12">
      <svg class="animate-spin h-8 w-8 text-blue-600" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor"
              d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z">
        </path>
      </svg>
    </div>
  }
  else if (friends.Length == 0)
  {
    <div class="card p-12 text-center">
      <div
        class="w-16 h-16 bg-gray-50 rounded-full flex items-center justify-center text-gray-400 mx-auto mb-4 text-2xl border border-gray-100">
        <span>👥</span>
      </div>
      <h3 class="text-lg font-bold text-gray-900 mb-2">No friends yet</h3>
      <p class="text-gray-500 max-w-sm mx-auto mb-8 text-sm">
        Start connecting with people to build your network! You can search for users or invite them to Scobius.
      </p>
      <button class="btn-primary">
        Find People
      </button>
    </div>
  }
  else
  {
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      @foreach (var friend in friends)
      {
        <div class="card-hover p-4 flex items-center gap-4">
          <div class="relative shrink-0">
            <img src="@(string.IsNullOrEmpty(friend.AvatarUrl) ? "/favicon.png" : friend.AvatarUrl)"
                 class="w-12 h-12 rounded-full object-cover border border-gray-100 shadow-sm" />
            <span class="absolute bottom-0 right-0 w-3 h-3 bg-green-500 border-2 border-white rounded-full"></span>
          </div>
          <div class="flex-1 min-w-0">
            <h4 class="text-sm font-bold text-gray-900 truncate">@friend.DisplayName</h4>
            <p class="text-xs text-gray-500 truncate">@friend.Bio</p>
          </div>
          <div class="flex items-center gap-2">
            <button class="btn-ghost p-2" title="Message">
              <span>💬</span>
            </button>
            <div class="relative group">
              <button class="btn-ghost p-2">
                <span>⋮</span>
              </button>
            </div>
          </div>
        </div>
      }
    </div>
  }
</div>

@code {
  private UserInfoModel[] friends = [];
  private bool isLoading = true;

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (!firstRender) return;
    await GetFriendsList();

  }

  private async Task GetFriendsList()
  {
    isLoading = true;
    StateHasChanged();

    try
    {
      var result = await UserService.GetFriends();
      if (result.Success)
      {
        friends = result.Friends;
      }
    }
    catch (Exception ex)
    {
      Console.WriteLine(ex);
    }
    finally
    {
      isLoading = false;
      StateHasChanged();
    }
  }
}
