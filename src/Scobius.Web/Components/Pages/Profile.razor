@page "/profile"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IWebUserService UserService

<PageTitle>Profile — Scobius</PageTitle>

<div>
  <h3 class="mb-4 fw-bold">My Profile</h3>

  @if (!string.IsNullOrEmpty(successMessage))
  {
    <div class="alert alert-success py-2">@successMessage</div>
  }
  @if (!string.IsNullOrEmpty(errorMessage))
  {
    <div class="alert alert-danger py-2">@errorMessage</div>
  }

  @if (profile == null)
  {
    <div class="d-flex justify-content-center py-5">
      <div class="spinner-border text-primary"></div>
    </div>
  }
  else
  {
    <div class="card shadow-sm p-4">
      <div class="row align-items-center mb-4">
        <div class="col-auto">
          <img src="@(string.IsNullOrEmpty(profile.AvatarUrl) ? "/favicon.png" : profile.AvatarUrl)"
               class="rounded-circle" style="width:90px;height:90px;object-fit:cover;" />
        </div>
        <div class="col">
          <h5 class="mb-0 fw-bold">@profile.DisplayName</h5>
          <p class="text-muted small mb-1">@@<span>@profile.Id</span></p>
          <InputFile OnChange="HandleAvatarUpload" class="form-control form-control-sm mt-1"
                     accept="image/*" disabled="@isUploadingAvatar" />
          @if (isUploadingAvatar)
          {
            <small class="text-muted">Uploading...</small>
          }
        </div>
      </div>

      <EditForm Model="updateModel" OnValidSubmit="HandleUpdate">
        <DataAnnotationsValidator />

        <div class="mb-3">
          <label class="form-label">Display Name</label>
          <InputText class="form-control" @bind-Value="updateModel.DisplayName" />
        </div>
        <div class="mb-3">
          <label class="form-label">Bio</label>
          <InputTextArea class="form-control" @bind-Value="updateModel.Bio" rows="3"
                         placeholder="Tell people a little about yourself..." />
        </div>

        <button type="submit" class="btn btn-primary" disabled="@isSaving">
          @(isSaving ? "Saving..." : "Save Changes")
        </button>
      </EditForm>
    </div>
  }
</div>

@code {
  private UserProfileModel? profile;
  private UpdateModel updateModel = new();
  private string? successMessage;
  private string? errorMessage;
  private bool isSaving;
  private bool isUploadingAvatar;

  // OnAfterRenderAsync ensures the auth token is available before making API calls
  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (!firstRender) return;
    await LoadProfile();
    StateHasChanged();
  }

  private async Task LoadProfile()
  {
    try
    {
      profile = await UserService.GetProfileAsync();
      if (profile != null)
      {
        updateModel.DisplayName = profile.DisplayName;
        updateModel.Bio = profile.Bio;
      }
    }
    catch (Exception ex)
    {
      errorMessage = "Failed to load profile.";
      Console.WriteLine(ex);
    }
  }

  private async Task HandleUpdate()
  {
    isSaving = true;
    successMessage = null;
    errorMessage = null;
    try
    {
      await UserService.UpdateProfileAsync(updateModel.DisplayName, updateModel.Bio);
      await LoadProfile();
      successMessage = "Profile updated successfully.";
    }
    catch (Exception ex)
    {
      errorMessage = "Failed to update profile.";
      Console.WriteLine(ex);
    }
    finally { isSaving = false; }
  }

  private async Task HandleAvatarUpload(InputFileChangeEventArgs e)
  {
    isUploadingAvatar = true;
    successMessage = null;
    errorMessage = null;
    try
    {
      var file = e.File;
      var content = new MultipartFormDataContent();
      var fileContent = new StreamContent(file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024));
      fileContent.Headers.ContentType =
          new System.Net.Http.Headers.MediaTypeHeaderValue(file.ContentType);
      content.Add(fileContent, "file", file.Name);
      await UserService.UpdateAvatarAsync(content);
      await LoadProfile();
      successMessage = "Avatar updated.";
    }
    catch (Exception ex)
    {
      errorMessage = "Failed to upload avatar.";
      Console.WriteLine(ex);
    }
    finally { isUploadingAvatar = false; }
  }

  private class UpdateModel
  {
    public string? DisplayName { get; set; }
    public string? Bio { get; set; }
  }
}