@page "/profile"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IWebUserService UserService

<PageTitle>Profile — Scobius</PageTitle>

<div class="max-w-3xl">
  <div class="mb-8">
    <h3 class="text-2xl font-bold text-gray-900 tracking-tight">My Profile</h3>
    <p class="text-sm text-gray-500 mt-1">Manage your public information and account settings.</p>
  </div>

  @if (!string.IsNullOrEmpty(successMessage))
  {
    <div class="mb-6 p-4 bg-green-50 border-l-4 border-green-500 text-green-700 text-sm">
      <p class="font-medium">Success</p>
      <p>@successMessage</p>
    </div>
  }
  @if (!string.IsNullOrEmpty(errorMessage))
  {
    <div class="mb-6 p-4 bg-red-50 border-l-4 border-red-500 text-red-700 text-sm">
      <p class="font-medium">Error</p>
      <p>@errorMessage</p>
    </div>
  }

  @if (profile == null)
  {
    <div class="flex justify-center py-12">
      <svg class="animate-spin h-8 w-8 text-blue-600" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
      </svg>
    </div>
  }
  else
  {
    <div class="card p-6 md:p-8">
        <div class="flex flex-col md:flex-row items-center gap-6 mb-8 pb-8 border-b border-gray-100">
          <div class="relative group">
            <img src="@(string.IsNullOrEmpty(profile.AvatarUrl) ? "/favicon.png" : profile.AvatarUrl)"
                 class="w-24 h-24 rounded-full object-cover border-4 border-white shadow-md ring-1 ring-gray-100" />
            @if (isUploadingAvatar)
            {
              <div class="absolute inset-0 bg-black/40 rounded-full flex items-center justify-center">
                <svg class="animate-spin h-6 w-6 text-white" fill="none" viewBox="0 0 24 24">
                  <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                  <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                </svg>
              </div>
            }
          </div>
          <div class="flex-1 text-center md:text-left">
            <h5 class="text-xl font-bold text-gray-900">@profile.DisplayName</h5>
            <p class="text-sm text-gray-500 mb-4 font-mono">@@@profile.Id</p>
            <div class="relative">
              <label class="btn-secondary cursor-pointer">
                <span>Change Photo</span>
                <InputFile OnChange="HandleAvatarUpload" class="absolute inset-0 opacity-0 cursor-pointer"
                           accept="image/*" disabled="@isUploadingAvatar" />
              </label>
            </div>
          </div>
        </div>

        <EditForm Model="updateModel" OnValidSubmit="HandleUpdate" class="space-y-6">
          <DataAnnotationsValidator />

          <div>
            <label class="label">Display Name</label>
            <InputText class="input" @bind-Value="updateModel.DisplayName" />
          </div>
          <div>
            <label class="label">Bio</label>
            <InputTextArea class="input" @bind-Value="updateModel.Bio" rows="3"
                           placeholder="Tell people a little about yourself..." />
          </div>

          <div class="flex justify-end pt-4">
            <button type="submit" class="btn-primary px-8" disabled="@isSaving">
              @(isSaving ? "Saving..." : "Save Changes")
            </button>
          </div>
        </EditForm>
    </div>
  }
</div>

@code {
  private UserProfileModel? profile;
  private UpdateModel updateModel = new();
  private string? successMessage;
  private string? errorMessage;
  private bool isSaving;
  private bool isUploadingAvatar;

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (!firstRender) return;
    await LoadProfile();
    StateHasChanged();
  }

  private async Task LoadProfile()
  {
    try
    {
      profile = await UserService.GetProfileAsync();
      if (profile != null)
      {
        updateModel.DisplayName = profile.DisplayName;
        updateModel.Bio = profile.Bio;
      }
    }
    catch (Exception ex)
    {
      errorMessage = "Failed to load profile.";
      Console.WriteLine(ex);
    }
  }

  private async Task HandleUpdate()
  {
    isSaving = true;
    successMessage = null;
    errorMessage = null;
    try
    {
      await UserService.UpdateProfileAsync(updateModel.DisplayName, updateModel.Bio);
      await LoadProfile();
      successMessage = "Profile updated successfully.";
    }
    catch (Exception ex)
    {
      errorMessage = "Failed to update profile.";
      Console.WriteLine(ex);
    }
    finally { isSaving = false; }
  }

  private async Task HandleAvatarUpload(InputFileChangeEventArgs e)
  {
    isUploadingAvatar = true;
    successMessage = null;
    errorMessage = null;
    try
    {
      var file = e.File;
      var content = new MultipartFormDataContent();
      var fileContent = new StreamContent(file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024));
      fileContent.Headers.ContentType =
          new System.Net.Http.Headers.MediaTypeHeaderValue(file.ContentType);
      content.Add(fileContent, "file", file.Name);
      await UserService.UpdateAvatarAsync(content);
      await LoadProfile();
      successMessage = "Avatar updated.";
    }
    catch (Exception ex)
    {
      errorMessage = "Failed to upload avatar.";
      Console.WriteLine(ex);
    }
    finally { isUploadingAvatar = false; }
  }

  private class UpdateModel
  {
    public string? DisplayName { get; set; }
    public string? Bio { get; set; }
  }
}
